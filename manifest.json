{
  "manifest_version": 3,
  "name": "On bloque l’extrême droite. Automatiquement",
  "version": "2.14",
  "description": "Outil indépendant qui automatise le blocage sur X, TikTok, Instagram et Facebook, à partir de la liste de l'annuaire onbloquelextremedroite.fun (initiative de @unfachoko).",
  "permissions": [
    "alarms",
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://onbloquelextremedroite.fun/*",
    "https://x.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://www.facebook.com/*"
  ],
  "action": {
    "default_title": "On bloque l’extrême droite. Automatiquement",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}